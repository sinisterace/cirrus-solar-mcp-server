# Copy this file to .env and fill in the values
# NEVER commit .env to git — it contains your secret PAT

# Snowflake account identifier (orgname-accountname format)
SNOWFLAKE_ACCOUNT=myorg-myaccount

# Programmatic Access Token from Snowflake (the long JWT)
SNOWFLAKE_PAT=your_pat_token_here

# Snowflake resources (defaults already set in code)
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CIRRUSSOLAR
SNOWFLAKE_SCHEMA=PUBLIC
SEMANTIC_MODEL_FILE=@CIRRUSSOLAR.PUBLIC.CIRRUS_SOLAR_STAGE/cirrus_solar_semantic_model.yaml

# Port (Railway sets this automatically)
PORT=3000
